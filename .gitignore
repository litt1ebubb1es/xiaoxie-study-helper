# ---- 虚拟环境 / 缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- 运行时数据：API Key、录音、数据库、模型权重、日志全在这里，不进仓库
data/*
!data/config.example.json
!data/selftest.db

# ---- 视频工程的中间产物（逐帧 PNG 与成片几百 MB）
docs/video/work/
docs/video/out/
docs/video/**/__pycache__/
# 背景音乐换了机器没有意义，且原曲许可见 assets/README 说明
docs/video/assets/*.mp3

# ---- 第三方参考材料（只用于阅读，版权不属于本项目）
_ref/

# ---- 打包与快捷方式
*.exe
*.lnk
build/
dist/

# ---- 编辑器 / 系统垃圾
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- 临时
tmp/
*.log
# 演示视频母版与转码产物（25 MB 级，走服务器/Release，不进仓库）
webdemo/video/*.mp4
简易演示.mp4
tmp_frames/
tmp_deploy/
tmp_demo/
docs/video/out/*.mp4

# 原始录屏素材（50 MB 级，只在本地转码用；成片走 webdemo/video/ 或服务器）
视频2.mp4

# DSH 知识库（本机工作区状态，不属于项目）
.dsh-knowledge/
